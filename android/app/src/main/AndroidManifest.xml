<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ae.veto.app">

  <!-- Kiki over other apps (only shown when something needs the user) -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- call state (never audio) and the saved-contacts comparison -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <!-- which app is in front, ONLY during a call with an unknown number or inside a flagged chat -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- optional online checks: sends only a link or a phone number -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />

  <queries>
    <!-- the chat apps the user can choose for Veto to read (shows only the installed ones) -->
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
    <package android:name="org.telegram.messenger" />
    <package android:name="org.telegram.messenger.web" />
    <package android:name="com.google.android.apps.messaging" />
    <package android:name="com.samsung.android.messaging" />
    <package android:name="com.android.mms" />
    <package android:name="com.android.messaging" />
    <package android:name="org.thoughtcrime.securesms" />
    <package android:name="com.facebook.orca" />
    <package android:name="com.instagram.android" />
    <package android:name="im.thebot.messenger" />
    <package android:name="com.viber.voip" />
    <package android:name="com.imo.android.imoim" />
    <package android:name="com.snapchat.android" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <application
      android:label="Veto"
      android:icon="@drawable/ic_launcher"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:usesCleartextTraffic="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Link Shield: links you tap come here first; text shared into Veto is checked too -->
    <activity android:name=".LinkShieldActivity" android:exported="true" android:label="Veto Link Shield"
        android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
        android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleInstance">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="http" />
        <data android:scheme="https" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <service android:name=".ChatListener" android:exported="true" android:label="Veto scam check"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- optional in-chat highlighter (Accessibility), read-only, limited to the chat apps the user chose -->
    <service android:name=".ChatScreen" android:exported="true" android:label="@string/chat_screen_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/chat_screen" />
    </service>

    <!-- Fake-Number Interceptor: holds an OUTGOING call to a number from a scam and offers the real one (Android 10+) -->
    <service android:name=".OutgoingGuard" android:exported="true"
        android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.CallRedirectionService" />
      </intent-filter>
    </service>
    <activity android:name=".InterceptActivity" android:exported="false"
        android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
        android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleInstance" />

    <service android:name=".CallGuard" android:exported="true"
        android:permission="android.permission.BIND_SCREENING_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.CallScreeningService" />
      </intent-filter>
    </service>
    <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
